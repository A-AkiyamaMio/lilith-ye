---
import PublicLayout from '../layouts/PublicLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Reveal from '../components/Reveal.astro';
import { lilithPublicProfile } from '../data/lilith';
---
<PublicLayout title="Lilith" active="/lilith">
  <div class="site-width">
    <section class="section character-intro" style="padding-top: 5rem;">
      <div class="character-copy"><p class="eyebrow">CHARACTER NOTE / LILITH</p><h1 class="page-title">她把光<br />留在眼睛里。</h1><div class="prose" style="margin-top:2rem;"><p>Lilith 是一个年轻的成年女性。她清纯、漂亮、安静，却并不透明。她更习惯观察，再决定要不要回应。</p><p>现代衣服让她看起来容易靠近；暗红色的虹膜内圈、浅蓝五角星吊坠，以及偶尔偏开的视线，提醒你她从来不只是一个普通的短剧女主。</p></div><div class="character-stats"><span><strong>{lilithPublicProfile.age}</strong> 岁 / 成人设定</span><span><strong>{lilithPublicProfile.heightCm}</strong> cm / 高挑比例</span></div></div><div class="portrait-frame" data-reveal="pending"><img src={lilithPublicProfile.visual.portrait} alt="莉莉丝日常肖像，柔黑发丝与清透肤色" /></div>
    </section>
    <section class="section"><SectionHeading eyebrow="SIGNATURES" title="三个记忆点" summary="足够轻，能进入日常；足够准，一眼能认出她。" /><div class="card-grid">{lilithPublicProfile.signatures.map((signature, index) => <Reveal><article class="info-card"><p class="eyebrow">0{index + 1}</p><h3>{['暗红虹膜内圈', '浅蓝五角星', '现代状态'][index]}</h3><p>{signature}</p></article></Reveal>)}</div></section>
    <section class="section"><SectionHeading eyebrow="STATES" title="同一个人，两种靠近方式" summary="服装和发型可以变化，脸、比例与那一点危险的目光不变。" /><div class="state-grid">{lilithPublicProfile.states.map((state) => <article class="state-card"><div class="state-image"><img src={state.image} alt={`莉莉丝${state.name}状态`} /></div><div><p class="eyebrow">{state.id === 'high-ponytail' ? 'STATE A' : 'STATE B'}</p><h3>{state.name}</h3><p>{state.description}</p></div></article>)}</div></section>
  </div>
</PublicLayout>
