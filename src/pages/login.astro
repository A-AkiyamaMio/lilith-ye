---
import '../styles/global.css';
import '../styles/framework.css';
import '../styles/auth.css';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#050407" />
    <meta name="robots" content="noindex,nofollow" />
    <title>管理员登录 · Lilith</title>
  </head>
  <body class="auth-shell">
    <a class="skip-link" href="#login-form">跳到登录表单</a>
    <main class="auth-stage">
      <a class="auth-brand" href="/" aria-label="返回莉莉丝展览首页">
        <span class="auth-brand-mark">L</span>
        <span>LILITH / PRIVATE ACCESS</span>
      </a>
      <section class="auth-intro" aria-labelledby="auth-title">
        <p class="eyebrow">THE MIRROR REMEMBERS</p>
        <h1 id="auth-title">只允许一个人<br /><em>走进镜后。</em></h1>
        <p>公开展览止于此处。档案、修订与未公开记录，留给管理员 Mio。</p>
        <a class="auth-return" href="/">← 返回公开展览</a>
      </section>
      <section class="auth-panel" aria-label="管理员登录">
        <div class="auth-mirror" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="auth-panel-copy">
          <p class="auth-sequence">ACCESS / 01</p>
          <h2>欢迎回来。</h2>
          <p>用管理员账号或邮箱继续。</p>
        </div>
        <form id="login-form" class="auth-form" novalidate>
          <div class="auth-field">
            <label for="identifier">账号或邮箱</label>
            <input id="identifier" name="identifier" type="text" autocomplete="username" maxlength="254" required />
          </div>
          <div class="auth-field">
            <label for="password">密码</label>
            <div class="auth-password">
              <input id="password" name="password" type="password" autocomplete="current-password" maxlength="256" required />
              <button type="button" data-password-toggle aria-controls="password" aria-pressed="false">显示</button>
            </div>
          </div>
          <label class="auth-remember"><input name="remember" type="checkbox" /><span>在这台设备上记住我</span></label>
          <button class="auth-submit" type="submit"><span>进入私人档案</span><span aria-hidden="true">↗</span></button>
          <p class="auth-status" data-auth-status aria-live="polite"></p>
        </form>
      </section>
    </main>
    <div class="auth-orbit auth-orbit-one" aria-hidden="true"></div>
    <div class="auth-orbit auth-orbit-two" aria-hidden="true"></div>
    <script>import { initLoginForm } from '../lib/auth-client'; initLoginForm();</script>
  </body>
</html>

