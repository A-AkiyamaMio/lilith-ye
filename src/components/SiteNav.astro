---
import navigation from '../../data/navigation.json';
const { active = '' } = Astro.props;
---
<nav class="site-nav" aria-label="主导航">
  <a class="brand" href="/" aria-label="返回莉莉丝展览首页">
    <span class="brand-mark">L</span>
    <span>LILITH</span>
    <small class="brand-meta">velvet mirror / 01</small>
  </a>
  <div class="site-nav-links">
    {navigation.map((item, index) => (
      <a href={item.href} aria-current={active === item.href ? 'page' : undefined}>
        <span class="nav-index">0{index + 1}</span><span class="nav-label">{item.label}</span>
      </a>
    ))}
    <a href="/login/" aria-current={active === '/login/' ? 'page' : undefined}>
      <span class="nav-index">05</span><span class="nav-label">登录</span>
    </a>
  </div>
</nav>
