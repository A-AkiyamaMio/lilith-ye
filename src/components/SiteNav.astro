---
import navigation from '../../data/navigation.json';
const { active = '' } = Astro.props;
---
<nav class="site-nav" aria-label="主导航">
  <a class="brand" href="/" aria-label="返回莉莉丝展览首页">LILITH <small>velvet mirror</small></a>
  <div class="site-nav-links">
    {navigation.map((item) => <a href={item.href} aria-current={active === item.href ? 'page' : undefined}>{item.label}</a>)}
  </div>
</nav>
