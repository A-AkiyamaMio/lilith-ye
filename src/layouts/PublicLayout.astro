---
import '../styles/global.css';
import '../styles/framework.css';
import SiteNav from '../components/SiteNav.astro';
import PageTransition from '../components/PageTransition.astro';
import AmbientField from '../components/AmbientField.astro';
import CursorAura from '../components/CursorAura.astro';
const {
  title,
  active = '',
  description = 'Lilith 的暗色动态角色展览：她的气质、状态与世界。',
} = Astro.props;
const pageTitle = `${title} · Lilith`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL('/assets/lilith/state-default.jpg', Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#050407" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
  </head>
  <body data-page-root>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <CursorAura />
    <div class="site-shell">
      <AmbientField />
      <SiteNav active={active} />
      <main id="main"><slot /></main>
      <PageTransition />
    </div>
    <script>
      import { initMotion } from '../lib/motion';
      initMotion();
    </script>
  </body>
</html>
